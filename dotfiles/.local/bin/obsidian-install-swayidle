#!/usr/bin/env bash
set -euo pipefail

temporary="$(mktemp -d /tmp/obsidian-swayidle.XXXXXX)"
trap 'rm -rf "$temporary"' EXIT

dnf --setopt=logdir=/tmp download --destdir="$temporary" --arch="$(uname -m)" swayidle
rpm_path="$(find "$temporary" -maxdepth 1 -name 'swayidle-*.rpm' -print -quit)"
[[ -f "$rpm_path" ]] || { printf 'Could not download swayidle RPM\n' >&2; exit 1; }
mkdir -p "$temporary/extracted"
(
  cd "$temporary/extracted"
  rpm2cpio "$rpm_path" | cpio -idm
)
install -D -m 0755 "$temporary/extracted/usr/bin/swayidle" "$HOME/.local/bin/swayidle"
printf 'Installed Fedora swayidle to %s\n' "$HOME/.local/bin/swayidle"
