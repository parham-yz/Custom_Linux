#!/usr/bin/env bash
set -euo pipefail

config_root="${XDG_CONFIG_HOME:-$HOME/.config}/obsidian-ember"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/obsidian-ember"
themes_root="$config_root/themes"
templates_root="$config_root/theme-templates"
current_root="$config_root/current"

die() {
  notify-send "Obsidian Theme" "$1" 2>/dev/null || true
  printf '%s\n' "$1" >&2
  exit 1
}

theme_dirs() {
  find "$themes_root" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

current_theme() {
  cat "$state_root/current-theme" 2>/dev/null || printf 'obsidian-ember\n'
}

load_palette() {
  local slug="$1"
  [[ "$slug" =~ ^[a-z0-9-]+$ ]] || die "Invalid theme name"
  [[ -f "$themes_root/$slug/palette" ]] || die "Theme '$slug' does not exist"
  # Palettes are installed with this desktop and contain color assignments only.
  OPACITY="0.92"
  source "$themes_root/$slug/palette"
}

render() {
  local template="$1" destination="$2" temporary
  local -a keys=(BG PANEL HOVER BORDER TEXT MUTED ACCENT ACCENT2 DANGER CONTRAST OPACITY C0 C1 C2 C3 C4 C5 C6 C7 C8 C9 C10 C11 C12 C13 C14 C15)
  local -a replacements=()
  local key

  for key in "${keys[@]}"; do
    replacements+=("-e" "s|{{$key}}|${!key}|g")
  done

  mkdir -p "$(dirname -- "$destination")"
  temporary="$(mktemp "${destination}.XXXXXX")"
  sed "${replacements[@]}" "$templates_root/$template" > "$temporary"
  chmod 0644 "$temporary"
  mv -f "$temporary" "$destination"
}

background_files() {
  local slug="$1"
  find "$themes_root/$slug/wallpapers" "$config_root/backgrounds/$slug" \
    -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
    -print 2>/dev/null | sort
}

apply_background() {
  local wallpaper="$1" quoted
  [[ -f "$wallpaper" ]] || die "Wallpaper not found"
  mkdir -p "$state_root"
  printf '%s\n' "$wallpaper" > "$state_root/current-wallpaper"
  pkill -x swaybg 2>/dev/null || true
  printf -v quoted '%q' "$wallpaper"
  hyprctl dispatch exec "swaybg -i $quoted -m fill" >/dev/null 2>&1 || true
}

set_theme() {
  local slug="$1" wallpaper
  load_palette "$slug"
  mkdir -p "$current_root" "$state_root" "$config_root/backgrounds/$slug"

  render waybar.css.tpl "$current_root/waybar.css"
  render rofi.rasi.tpl "$current_root/rofi.rasi"
  render kitty.conf.tpl "$current_root/kitty.conf"
  render hyprland.conf.tpl "$current_root/hyprland.conf"
  render mako.conf.tpl "$HOME/.config/mako/config"
  render btop.theme.tpl "$HOME/.config/btop/themes/obsidian-current.theme"
  render starship.toml.tpl "$HOME/.config/starship.toml"

  printf '%s\n' "$slug" > "$state_root/current-theme"
  wallpaper="$(cat "$state_root/wallpaper-$slug" 2>/dev/null || true)"
  if [[ ! -f "$wallpaper" ]]; then
    wallpaper="$(background_files "$slug" | head -n 1)"
  fi
  [[ -n "$wallpaper" ]] && apply_background "$wallpaper"

  hyprctl reload >/dev/null 2>&1 || true
  if command -v obsidian-toggle >/dev/null; then obsidian-toggle reapply; fi
  pkill -SIGUSR2 waybar 2>/dev/null || true
  if ! pgrep -x waybar >/dev/null; then
    hyprctl dispatch exec waybar >/dev/null 2>&1 || true
  fi
  makoctl reload 2>/dev/null || true
  # Kitty documents SIGUSR1 as a configuration reload; running shells stay open.
  pkill -SIGUSR1 -u "$UID" -x kitty 2>/dev/null || true
  notify-send "Theme changed" "$THEME_NAME" 2>/dev/null || true
}

choose_theme() {
  local selected slug active=0 index=0 current
  local -a slugs=() rows=()
  current="$(current_theme)"
  while IFS= read -r slug; do
    load_palette "$slug"
    slugs+=("$slug")
    rows+=("$THEME_NAME   ·   $MODE")
    [[ "$slug" == "$current" ]] && active=$index
    index=$((index + 1))
  done < <(theme_dirs)
  selected="$(printf '%s\n' "${rows[@]}" | rofi -dmenu -i -no-custom -no-sort -format i \
    -selected-row "$active" -a "$active" -p 'Theme' -mesg 'One palette for the desktop · Enter to apply' \
    -theme-str 'entry { placeholder: "Search themes…"; }')" || return 0
  [[ "$selected" =~ ^[0-9]+$ ]] && ((selected < ${#slugs[@]})) || return 0
  set_theme "${slugs[selected]}"
}

choose_background() {
  local slug selected path
  slug="$(current_theme)"
  mapfile -t paths < <(background_files "$slug")
  ((${#paths[@]})) || die "No wallpapers are installed for $slug"
  selected="$(for path in "${paths[@]}"; do printf '%s\0icon\x1f%s\n' "${path##*/}" "$path"; done | \
    rofi -dmenu -i -no-custom -show-icons -p 'Wallpaper' -format i \
      -mesg 'Choose a background for the current theme' \
      -theme-str 'element-icon { size: 96px; } listview { lines: 4; } entry { placeholder: "Search wallpapers…"; }')" || return 0
  [[ "$selected" =~ ^[0-9]+$ ]] || exit 0
  ((selected < ${#paths[@]})) || return 0
  path="${paths[$selected]}"
  printf '%s\n' "$path" > "$state_root/wallpaper-$slug"
  apply_background "$path"
}

next_background() {
  local slug current next_index=0 index
  slug="$(current_theme)"
  current="$(cat "$state_root/current-wallpaper" 2>/dev/null || true)"
  mapfile -t paths < <(background_files "$slug")
  ((${#paths[@]})) || die "No wallpapers are installed for $slug"
  for index in "${!paths[@]}"; do
    if [[ "${paths[$index]}" == "$current" ]]; then
      next_index=$(( (index + 1) % ${#paths[@]} ))
      break
    fi
  done
  printf '%s\n' "${paths[$next_index]}" > "$state_root/wallpaper-$slug"
  apply_background "${paths[$next_index]}"
}

case "${1:-switch}" in
  set) [[ $# -eq 2 ]] || die "Usage: obsidian-theme set <name>"; set_theme "$2" ;;
  restore) set_theme "$(current_theme)" ;;
  switch) choose_theme ;;
  list) theme_dirs ;;
  current) current_theme ;;
  name) load_palette "$(current_theme)"; printf '%s\n' "$THEME_NAME" ;;
  color)
    [[ "${2:-}" =~ ^(BG|PANEL|TEXT|MUTED|ACCENT|ACCENT2|BORDER|DANGER)$ ]] || die 'Unknown color role'
    load_palette "$(current_theme)"
    printf '%s\n' "${!2}"
    ;;
  wallpaper) choose_background ;;
  next-background) next_background ;;
  *) die "Usage: obsidian-theme {set|restore|switch|list|current|name|color ROLE|wallpaper|next-background}" ;;
esac
