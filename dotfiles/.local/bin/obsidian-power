#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/obsidian-ember/power"
mode_file="$state_dir/mode"
daemon_pid="$state_dir/daemon.pid"
bluetooth_marker="$state_dir/bluetooth-blocked"
ac_path="${OBSIDIAN_AC_ONLINE_PATH:-/sys/class/power_supply/macsmc-ac/online}"
backlight_device="${OBSIDIAN_BACKLIGHT_DEVICE:-apple-panel-bl}"
profile_bus="net.hadess.PowerProfiles"
profile_object="/net/hadess/PowerProfiles"
profile_interface="net.hadess.PowerProfiles"
mkdir -p "$state_dir"

on_ac() {
  [[ -r "$ac_path" ]] && [[ "$(<"$ac_path")" == 1 ]]
}

daemon_running() {
  local pid command_line
  [[ -s "$daemon_pid" ]] || return 1
  pid="$(<"$daemon_pid")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ -r "/proc/$pid/cmdline" ]] || return 1
  command_line="$(tr '\0' ' ' < "/proc/$pid/cmdline")"
  [[ "$command_line" == *'obsidian-power daemon'* ]]
}

active_profile() {
  busctl --system get-property \
    "$profile_bus" "$profile_object" "$profile_interface" ActiveProfile 2>/dev/null |
    sed -n 's/^s "\(.*\)"$/\1/p'
}

set_profile() {
  local profile="$1"
  [[ "$(active_profile)" == "$profile" ]] && return 0
  busctl --system set-property \
    "$profile_bus" "$profile_object" "$profile_interface" ActiveProfile s "$profile"
}

set_blur() {
  command -v hyprctl >/dev/null || return 0
  "$HOME/.local/bin/obsidian-hyprctl" keyword decoration:blur:enabled "$1" >/dev/null 2>&1 || true
  "$HOME/.local/bin/obsidian-hyprctl" keyword animations:enabled "$1" >/dev/null 2>&1 || true
}

cap_brightness() {
  local percent
  command -v brightnessctl >/dev/null || return 0
  percent="$(brightnessctl -d "$backlight_device" -m | cut -d, -f4 | tr -d '%')"
  [[ "$percent" =~ ^[0-9]+$ ]] || return 0
  ((percent <= 55)) || brightnessctl -q -d "$backlight_device" set 55%
}

restore_bluetooth() {
  [[ -f "$bluetooth_marker" ]] || return 0
  rfkill unblock bluetooth 2>/dev/null || true
  rm -f "$bluetooth_marker"
}

apply_mode() {
  local requested previous
  requested="${1:-auto}"
  previous="$(cat "$mode_file" 2>/dev/null || true)"
  if [[ "$requested" == auto ]]; then
    if on_ac; then requested=ac; else requested=battery; fi
  fi

  case "$requested" in
    battery)
      set_profile power-saver
      cap_brightness
      # Keep Bluetooth available for reconnecting devices on battery too.
      # Undo only a block previously created by this power policy.
      restore_bluetooth
      set_blur false
      ;;
    ac)
      set_profile balanced
      restore_bluetooth
      set_blur true
      ;;
    performance)
      set_profile performance
      restore_bluetooth
      set_blur true
      ;;
    *) printf 'Unknown power mode: %s\n' "$requested" >&2; return 2 ;;
  esac

  printf '%s\n' "$requested" > "$mode_file"
  if [[ "$previous" != "$requested" ]] && [[ "${2:-notify}" != quiet ]]; then
    if [[ "$requested" == battery ]]; then
      notify-send 'Low power mode' 'CPU limited • brightness capped at 55% • animations and blur off'
    elif [[ "$requested" == performance ]]; then
      notify-send 'High performance mode' 'Full CPU speed • higher power consumption'
    else
      notify-send 'AC mode' 'Balanced performance • full desktop effects'
    fi
  fi
}

status_text() {
  local battery_status capacity health power_raw watts profile brightness source
  battery_status="$(cat /sys/class/power_supply/macsmc-battery/status 2>/dev/null || printf unknown)"
  capacity="$(cat /sys/class/power_supply/macsmc-battery/capacity 2>/dev/null || printf '?')"
  health="$(upower -i /org/freedesktop/UPower/devices/battery_macsmc_battery 2>/dev/null |
    awk '/^[[:space:]]*capacity:/ {print $2; exit}')"
  power_raw="$(cat /sys/class/power_supply/macsmc-battery/power_now 2>/dev/null || printf 0)"
  watts="$(awk -v value="$power_raw" 'BEGIN {if (value < 0) value=-value; printf "%.1f", value/1000000}')"
  profile="$(active_profile)"
  brightness="$(brightnessctl -d "$backlight_device" -m 2>/dev/null | cut -d, -f4)"
  if on_ac; then source='AC power'; else source='battery'; fi
  printf '%s • %s%% • %s W\nProfile: %s • Brightness: %s • Health: %s\n' \
    "$source / $battery_status" "$capacity" "$watts" \
    "${profile:-unknown}" "${brightness:-unknown}" "${health:-unknown}"
  local policy maximum governor
  for policy in /sys/devices/system/cpu/cpufreq/policy*; do
    maximum="$(<"$policy/scaling_max_freq")"
    governor="$(<"$policy/scaling_governor")"
    printf '%s: max %s MHz (%s)\n' "${policy##*/}" "$((maximum / 1000))" "$governor"
  done
}

daemon() {
  local source previous_source
  if daemon_running && [[ "$(<"$daemon_pid")" != "$$" ]]; then
    exit 0
  fi
  printf '%s\n' "$$" > "$daemon_pid"
  trap 'rm -f "$daemon_pid"' EXIT
  if on_ac; then previous_source=ac; else previous_source=battery; fi
  apply_mode "$previous_source" quiet
  while IFS= read -r _; do
    if on_ac; then source=ac; else source=battery; fi
    # Battery percentage updates must not override a manually selected mode
    # or reconfigure the compositor. Only react to a charger transition.
    if [[ "$source" != "$previous_source" ]]; then
      apply_mode "$source"
      previous_source="$source"
      systemctl --user try-restart obsidian-idle.service
    fi
  done < <(upower --monitor)
  return 1
}

case "${1:-status}" in
  daemon) daemon ;;
  daemon-status) daemon_running ;;
  auto) apply_mode auto ;;
  battery|saver|low) apply_mode battery ;;
  ac|balanced) apply_mode ac ;;
  high|performance) apply_mode performance ;;
  menu)
    panel="${XDG_DATA_HOME:-$HOME/.local/share}/obsidian-power/panel.py"
    if [[ -f "$panel" ]] && /usr/bin/python3 -c 'import gi; gi.require_version("Gtk", "3.0"); gi.require_version("GtkLayerShell", "0.1")' 2>/dev/null; then
      exec /usr/bin/python3 "$panel"
    fi
    choice="$(printf 'Automatic\nLow power\nBalanced\nHigh performance\n' | rofi -dmenu -p 'Power mode')" || exit 0
    case "$choice" in
      Automatic) apply_mode auto ;;
      'Low power') apply_mode battery ;;
      Balanced) apply_mode ac ;;
      'High performance') apply_mode performance ;;
    esac
    ;;
  toggle)
    if [[ "$(active_profile)" == power-saver ]]; then
      apply_mode ac
    else
      apply_mode battery
    fi
    ;;
  status) status_text ;;
  notice) notify-send 'Power and battery' "$(status_text)" ;;
  *) printf 'Usage: obsidian-power {daemon|daemon-status|auto|low|balanced|high|menu|toggle|status|notice}\n' >&2; exit 2 ;;
esac
