#!/usr/bin/env bash
set -euo pipefail
export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"

choose() {
  local prompt="$1" message="$2" selected option
  shift 2
  local -a options=("$@")
  [[ "$prompt" == ' OMA ' || "$prompt" == Confirm ]] || options+=('󰁍  Back')
  selected="$(printf '%s\n' "${options[@]}" | rofi -dmenu -i -no-custom -no-sort \
    -p "$prompt" -mesg "$message" \
    -theme-str 'entry { placeholder: "Search actions…"; }')" || return 0
  # Accept only a supplied row, even when a launcher returns unexpected text.
  for option in "${options[@]}"; do
    [[ "$selected" == "$option" ]] && { printf '%s\n' "$option"; return 0; }
  done
  return 0
}

confirm() {
  local action="$1"
  [[ "$(choose 'Confirm' "$action" 'Cancel' "$action")" == "$action" ]]
}

root_menu() {
  local choice
  choice="$(choose ' OMA ' "$(obsidian-theme name) · Enter to open · Esc to close" \
    '󰀻  Applications' \
    '󱚣  AI agents' \
    '󰄀  Capture' \
    '󰏘  Style' \
    '󰔡  Quick settings' \
    '󰖩  Connectivity' \
    '󰒓  System' \
    '󰘳  Utilities' \
    '󰒓  Setup' \
    '󰌌  Keyboard shortcuts' \
    '󰋼  About')"
  case "$choice" in
    *Back) exec "$0" root ;;
    *Applications) rofi -show drun -show-icons ;;
    *AI\ agents) exec "$0" agents ;;
    *Capture) exec "$0" capture ;;
    *Style) exec "$0" style ;;
    *Quick\ settings) exec "$0" toggle ;;
    *Connectivity) exec "$0" connectivity ;;
    *System) exec "$0" system ;;
    *Utilities) exec "$0" utilities ;;
    *Setup) exec "$0" setup ;;
    *Keyboard\ shortcuts) obsidian-keybindings ;;
    *About) notify-send 'Your desktop' "$(. /etc/os-release; printf '%s' "$PRETTY_NAME") · Hyprland\nSuper+K shows keyboard shortcuts" ;;
  esac
}

agents_menu() {
  local choice prompt default_agent approval crash_state
  default_agent="$(obsidian-agent get 2>/dev/null || true)"
  approval="$(jq -r '.approvalMode // "ask"' "${XDG_CONFIG_HOME:-$HOME/.config}/obsidian-agent/config.json" 2>/dev/null || echo ask)"
  crash_state="$(obsidian-agent-crash-watch --status 2>/dev/null || echo unavailable)"
  choice="$(choose 'AI Agents' "Default: ${default_agent:-not selected} • approval: $approval • crash watch: $crash_state" \
    '󱚣  Open usage dashboard' \
    '󰆍  Launch default agent' \
    '󰚩  Choose default agent' \
    '󰭹  Start with a prompt' \
    '󰒓  Agent settings' \
    '󰑓  Refresh usage' \
    '󰅖  Toggle crash diagnosis')"
  case "$choice" in
    *Back) exec "$0" root ;;
    *dashboard) obsidian-agent usage panel ;;
    *Launch*) obsidian-agent launch ;;
    *Choose*) obsidian-agent pick ;;
    *prompt)
      prompt="$(printf '' | rofi -dmenu -p 'Agent prompt' -mesg 'Describe the task for your default agent.' \
        -theme-str 'entry { placeholder: "What would you like to do?"; }')" || return 0
      [[ -n $prompt ]] && obsidian-agent prompt "$prompt"
      ;;
    *settings) obsidian-agent settings ;;
    *Refresh*) systemctl --user start obsidian-agent-usage.service || obsidian-agent usage update --force ;;
    *crash*)
      obsidian-agent-crash-watch --toggle >/dev/null
      systemctl --user restart obsidian-agent-crash-watch.service 2>/dev/null || true
      ;;
  esac
}

capture_menu() {
  local choice
  choice="$(choose 'Capture' 'Screenshots → Pictures/Screenshots · Recordings → Videos/Recordings' \
    '󰹑  Region screenshot' \
    '󰍹  Full-screen screenshot' \
    '󰖲  Active-window screenshot' \
    '󰑋  Screen recording' \
    '󰐲  Extract text (OCR)' \
    '󰏘  Pick color')"
  case "$choice" in
    *Back) exec "$0" root ;;
    *Region*) obsidian-capture region ;;
    *Full-screen*) obsidian-capture screen ;;
    *Active-window*) obsidian-capture window ;;
    *recording*) obsidian-record menu ;;
    *OCR*) obsidian-capture ocr ;;
    *color*) obsidian-capture color ;;
  esac
}

style_menu() {
  local choice
  choice="$(choose 'Style' "Current theme: $(obsidian-theme name)" \
    '󰏘  Choose theme' \
    '󰸉  Choose wallpaper' \
    '󰸉  Next wallpaper' \
    '󰍜  Toggle top bar' \
    '󰇙  Toggle window gaps' \
    '󰑓  Reload desktop')"
  case "$choice" in
    *Back) exec "$0" root ;;
    *theme) obsidian-theme switch ;;
    *Choose\ wallpaper) obsidian-theme wallpaper ;;
    *Next\ wallpaper) obsidian-theme next-background ;;
    *top\ bar) obsidian-toggle bar ;;
    *window\ gaps) obsidian-toggle gaps ;;
    *Reload*) obsidian-toggle reload ;;
  esac
}

toggle_menu() {
  local choice status
  status="$(obsidian-status states)"
  choice="$(choose 'Quick settings' 'Select to toggle · current states shown on the right' \
    "󰃠  Automatic brightness    $(jq -r .brightness <<<"$status")" \
    "󰒲  Keep awake              $(jq -r .awake <<<"$status")" \
    "󰾅  Power saver             $(jq -r .power <<<"$status")" \
    "󰖔  Night light             $(jq -r .nightlight <<<"$status")" \
    "󰂛  Do not disturb          $(jq -r .dnd <<<"$status")" \
    '󰍜  Top bar' \
    '󰇙  Window gaps')"
  case "$choice" in
    *Back) exec "$0" root ;;
    *Automatic*) obsidian-toggle autobrightness ;;
    *Keep\ awake*) obsidian-toggle idle ;;
    *Power*) obsidian-power toggle ;;
    *Night*) obsidian-toggle nightlight ;;
    *Do\ not\ disturb*) obsidian-toggle notifications ;;
    *Top\ bar) obsidian-toggle bar ;;
    *Window\ gaps) obsidian-toggle gaps ;;
  esac
  if [[ -n "$choice" ]]; then exec "$0" toggle; fi
}

connectivity_menu() {
  local choice
  choice="$(choose 'Connectivity' 'Connect devices and choose audio outputs' \
    '󰖩  Wi-Fi networks' '󰂯  Bluetooth devices' '󰓃  Audio controls' '󰒓  Saved network settings')"
  case "$choice" in
    *Back) exec "$0" root ;;
    *Wi-Fi*) obsidian-network ;;
    *Bluetooth*) obsidian-bluetooth ;;
    *Audio*) if command -v pavucontrol >/dev/null; then pavucontrol; else kitty alsamixer; fi ;;
    *Saved*) nm-connection-editor ;;
  esac
}

system_menu() {
  local lock_label='󰌾  Lock'
  command -v swaylock >/dev/null || lock_label='󰌾  Lock (install swaylock)'
  local choice
  choice="$(choose 'System' 'Power actions ask for confirmation' \
    "$lock_label" \
    '󰤄  Suspend' \
    '󰍃  Log out' \
    '󰜉  Reboot' \
    '󰐥  Power off')"
  case "$choice" in
    *Back) exec "$0" root ;;
    *Lock*)
      obsidian-lock
      ;;
    *Suspend)
      confirm 'Suspend' || return 0
      if command -v swaylock >/dev/null; then obsidian-lock; fi
      systemctl suspend ;;
    *Log\ out) confirm 'Log out' || return 0; hyprctl dispatch exit ;;
    *Reboot) confirm 'Reboot' || return 0; systemctl reboot ;;
    *Power\ off) confirm 'Power off' || return 0; systemctl poweroff ;;
  esac
}

utilities_menu() {
  local choice
  choice="$(choose 'Utilities' 'Omarchy-style quick tools' \
    '󰾅  Power and battery status' \
    '󰅌  Clipboard history' \
    '󰞅  Emoji picker' \
    '󰔛  Set reminder' \
    '󰔛  Show reminders' \
    '󰃭  Date and time notice' \
    '󰁹  Battery notice' \
    '󰖐  Weather notice' \
    '󰓅  System activity' \
    '󰓃  Audio controls' \
    '󰖩  Wi-Fi controls' \
    '󰂯  Bluetooth controls' \
    '󰆍  Terminal' \
    '󰉋  Files')"
  case "$choice" in
    *Back) exec "$0" root ;;
    *Power*) obsidian-power notice ;;
    *Clipboard*) obsidian-clipboard open ;;
    *Emoji*) obsidian-emoji ;;
    *Set\ reminder) obsidian-reminder set ;;
    *Show\ reminders) obsidian-reminder show ;;
    *Date*) obsidian-notice time ;;
    *Battery*) obsidian-notice battery ;;
    *Weather*) obsidian-notice weather ;;
    *activity) kitty btop --force-utf --config "$HOME/.config/btop/obsidian-ember.conf" ;;
    *Audio*) if command -v pavucontrol >/dev/null; then pavucontrol; else kitty alsamixer; fi ;;
    *Wi-Fi*) obsidian-network ;;
    *Bluetooth*) obsidian-bluetooth ;;
    *Terminal) kitty ;;
    *Files) dolphin ;;
  esac
}

setup_menu() {
  local choice theme
  theme="$(obsidian-theme current)"
  choice="$(choose 'Setup' 'Configuration and maintenance' \
    '󰋼  Fedora release information' \
    '󰒓  Edit Hyprland config' \
    '󰍜  Edit Waybar config' \
    '󰆍  Edit terminal config' \
    '󰸉  Open theme wallpapers' \
    '󰒓  KDE system settings' \
    '󰚰  Update Fedora + Homebrew' \
    '󰑓  Reload desktop')"
  case "$choice" in
    *Back) exec "$0" root ;;
    *Fedora\ release*) notify-send 'Fedora' "$(. /etc/os-release; printf '%s' "$PRETTY_NAME")" ;;
    *Hyprland*) kitty nvim "$HOME/.config/hypr/hyprland.conf" ;;
    *Waybar*) kitty nvim "$HOME/.config/waybar/config" ;;
    *terminal*) kitty nvim "$HOME/.config/kitty/kitty.conf" ;;
    *wallpapers*) dolphin "$HOME/.config/obsidian-ember/themes/$theme/wallpapers" ;;
    *system\ settings*) systemsettings ;;
    *Update*) obsidian-updates run ;;
    *Reload*) obsidian-toggle reload ;;
  esac
}

case "${1:-root}" in
  root) root_menu ;;
  agents) agents_menu ;;
  capture) capture_menu ;;
  style) style_menu ;;
  toggle) toggle_menu ;;
  connectivity) connectivity_menu ;;
  system) system_menu ;;
  utilities) utilities_menu ;;
  setup) setup_menu ;;
  *) root_menu ;;
esac
