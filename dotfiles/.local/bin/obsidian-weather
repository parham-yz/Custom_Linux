#!/usr/bin/python3
"""Weather bar output and native desktop panel."""
import json
import os
from pathlib import Path
import sys

# Works both from the installed tree and the portable dotfiles snapshot.
base = Path(__file__).resolve().parent.parent / 'share/obsidian-weather'
sys.path.insert(0, str(base))
import weather

command = sys.argv[1] if len(sys.argv) > 1 else 'bar'
if command in ('menu', 'notice'):
    os.execv('/usr/bin/python3', ['/usr/bin/python3', str(base / 'panel.py')])
elif command == 'bar':
    print(json.dumps(weather.bar(weather.fetch(weather.read_location())), ensure_ascii=False))
else:
    raise SystemExit('Usage: obsidian-weather {bar|menu|notice}')
