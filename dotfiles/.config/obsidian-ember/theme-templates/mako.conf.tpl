anchor=top-right
layer=overlay
outer-margin=54,12,12
width=360
height=130
padding=14
border-size=1
border-radius=11
icons=1
max-icon-size=48
font=JetBrainsMono Nerd Font 11
background-color=#{{BG}}f2
text-color=#{{TEXT}}
border-color=#{{BORDER}}cc
progress-color=over #{{HOVER}}
default-timeout=6000
ignore-timeout=0
max-visible=4
sort=-time

[urgency=low]
border-color=#{{MUTED}}99

[urgency=normal]
border-color=#{{ACCENT}}cc

[urgency=high]
border-color=#{{DANGER}}
default-timeout=0

[mode=do-not-disturb]
invisible=1
