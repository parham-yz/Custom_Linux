@theme "/dev/null"
@import "../obsidian-ember/current/rofi.rasi"

* {
  background-color: transparent;
  text-color: @fg;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 560px;
  location: northeast;
  anchor: northeast;
  x-offset: -10px;
  y-offset: 43px;
  background-color: @bg;
  border: 1px;
  border-color: @border;
  border-radius: 8px;
}

mainbox {
  padding: 14px;
  spacing: 10px;
}

inputbar {
  children: [prompt, entry];
  background-color: @panel;
  border-radius: 5px;
  padding: 12px 13px;
}

prompt {
  text-color: @accent;
  padding: 0 10px 0 0;
}

entry {
  placeholder: "Search networks…";
  placeholder-color: @muted;
}

message {
  background-color: transparent;
}

textbox {
  text-color: @muted;
  padding: 2px 4px 5px 4px;
  markup: true;
}

listview {
  lines: 12;
  columns: 1;
  fixed-height: false;
  scrollbar: true;
  spacing: 3px;
}

element {
  padding: 11px 12px;
  border-radius: 4px;
}

element selected {
  background-color: @selected;
  text-color: @accent;
}

element-text {
  vertical-align: 0.5;
  text-color: inherit;
}

scrollbar { width: 3px; handle-width: 3px; handle-color: @muted; background-color: @panel; }
