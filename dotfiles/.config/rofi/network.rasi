@theme "/dev/null"
@import "../obsidian-ember/current/rofi.rasi"

* {
  background-color: transparent;
  text-color: @fg;
  margin: 0;
  padding: 0;
  spacing: 0;
}

// Rofi 2.0 cannot receive Wayland clicks outside its surface. Transparent
// cancel buttons cover that area while the visible panel stays compact.
window {
  fullscreen: true;
  background-color: transparent;
  border: 0;
  border-radius: 0;
  children: [dismiss-layout];
}

dismiss-layout {
  expand: true;
  orientation: vertical;
  children: [button-dismiss-top, panel-row, button-dismiss-bottom];
}
panel-row {
  orientation: horizontal;
  expand: false;
  children: [button-dismiss-left, mainbox, button-dismiss-right];
}
button-dismiss-top, button-dismiss-bottom, button-dismiss-left, button-dismiss-right {
  content: "";
  action: "kb-cancel";
  background-color: transparent;
  border: 0;
  padding: 0;
  margin: 0;
  expand: true;
}
// Textbox buttons size from font metrics and padding, not the height property.
button-dismiss-top { expand: false; font: "monospace 1"; padding: 20px 0 21px; }
button-dismiss-right { expand: false; width: 10px; }
mainbox {
  expand: false;
  width: 560px;
  background-color: @bg;
  border: 1px;
  border-color: @border;
  border-radius: 8px;
  padding: 14px;
  spacing: 10px;
  children: [inputbar, message, listview];
}

inputbar {
  children: [prompt, entry];
  background-color: @panel;
  border-radius: 5px;
  padding: 12px 13px;
}

prompt {
  text-color: @accent;
  padding: 0 10px 0 0;
}

entry {
  placeholder: "Search networks…";
  placeholder-color: @muted;
}

message {
  background-color: transparent;
}

textbox {
  text-color: @muted;
  padding: 2px 4px 5px 4px;
  markup: true;
}

listview {
  lines: 12;
  columns: 1;
  // The menu wrappers set the row count before this fullscreen layout opens.
  fixed-height: true;
  scrollbar: true;
  spacing: 3px;
}

element {
  padding: 11px 12px;
  border-radius: 4px;
}

element selected {
  background-color: @selected;
  text-color: @accent;
}

element-text {
  vertical-align: 0.5;
  text-color: inherit;
}

scrollbar { width: 3px; handle-width: 3px; handle-color: @muted; background-color: @panel; }
