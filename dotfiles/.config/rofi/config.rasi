configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  drun-display-format: "{name}";
  font: "JetBrainsMono Nerd Font 12";
  matching: "fuzzy";
  sort: true;
}

@theme "/dev/null"
@import "../obsidian-ember/current/rofi.rasi"

* {
  background-color: transparent;
  text-color: @fg;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 620px;
  location: center;
  anchor: center;
  background-color: @bg;
  border: 1px;
  border-color: @border;
  border-radius: 8px;
}

mainbox { padding: 14px; spacing: 10px; }
inputbar {
  children: [prompt, entry];
  background-color: @panel;
  border-radius: 5px;
  padding: 12px;
}
prompt { text-color: @accent; padding: 0 10px 0 2px; }
entry { placeholder: "Search apps, commands, and windows…"; placeholder-color: @muted; }
listview { lines: 11; columns: 1; fixed-height: false; spacing: 3px; scrollbar: true; }
scrollbar { width: 3px; handle-width: 3px; handle-color: @muted; background-color: @panel; }
element { padding: 10px 12px; border-radius: 4px; }
element selected { background-color: @selected; text-color: @accent; }
element alternate.normal { background-color: transparent; }
element-icon { size: 24px; margin: 0 12px 0 0; text-color: inherit; }
element-text { vertical-align: 0.5; text-color: inherit; }
message { padding: 0 4px; }
textbox { text-color: @muted; }
error-message { padding: 16px; background-color: @bg; }
